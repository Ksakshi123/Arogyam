# Database URL
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/arogyam_db

# JWT Secret Key — REQUIRED. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional: Override the password salt (recommended for new deployments)
# PASSWORD_SALT=REPLACE_WITH_RANDOM_STRING

# AI/ML Microservice URL
AIML_SERVICE_URL=http://localhost:8001

# xAI / Grok API Configuration
XAI_API_KEY=YOUR_XAI_API_KEY_HERE
GROK_MODEL=grok-4.6
XAI_BASE_URL=https://api.x.ai/v1

# CORS — comma-separated list of allowed frontend origins
# Development defaults: http://localhost:5173,http://localhost:8080
# Production example: CORS_ALLOWED_ORIGINS=https://arogyam.com,https://www.arogyam.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
